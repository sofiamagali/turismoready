<%= form_with model: destination, class: "destination-form" do |form| %>
  <% if destination.errors.any? %>
    <div class="form-errors" role="alert">
      <h2>No se pudo guardar el destino:</h2>
      <ul>
        <% destination.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="destination-field-wide">
      <%= form.label :name, "Nombre" %>
      <%= form.text_field :name, required: true %>
    </div>
    <div>
      <%= form.label :country, "País" %>
      <%= form.text_field :country, required: true %>
    </div>
    <div>
      <%= form.label :city, "Ciudad" %>
      <%= form.text_field :city, required: true %>
    </div>
    <div class="destination-field-wide">
      <%= form.label :description, "Descripción" %>
      <%= form.text_area :description, rows: 5 %>
    </div>
    <div class="destination-field-wide">
      <%= form.label :image_url, "URL de imagen" %>
      <%= form.url_field :image_url, placeholder: "https://ejemplo.com/destino.jpg", aria: { describedby: "destination-image-help" } %>
      <p id="destination-image-help" class="field-help">Opcional. Si no cargás una imagen, se mostrará el nombre de la ciudad.</p>
    </div>
  </div>

  <div class="destination-active-field">
    <%= form.check_box :active %>
    <%= form.label :active, "Destino activo" %>
  </div>
  <div class="destination-actions">
    <%= form.submit "Guardar destino", class: "button" %>
    <%= link_to "Cancelar", destination.persisted? ? destination_path(destination) : destinations_path, class: "text-link" %>
  </div>
<% end %>
