<section class="page-hero">
  <div class="container">
    <p class="eyebrow">Próximas salidas</p>
    <h1>Elegí tu próximo viaje</h1>
    <p>Descubrí nuestros paquetes en <%= Trip::TRANSPORT_TYPES[@transport_type].downcase %>, con alojamiento y régimen incluido.</p>
    <nav class="destination-actions" aria-label="Tipo de viaje">
      <% Trip::TRANSPORT_TYPES.each do |value, label| %>
        <%= link_to "Viajes en #{label.downcase}", trips_path(transport_type: value), class: "button button-outline", aria: { current: (@transport_type == value ? "page" : nil) } %>
      <% end %>
    </nav>
  </div>
</section>

<section class="section container">
  <% if current_user&.admin? %>
    <%= link_to "Nuevo viaje", new_trip_path, class: "button" %>
  <% end %>
  <% if @trips.any? %>
    <div class="trip-grid">
      <%= render partial: "card", collection: @trips, as: :trip %>
    </div>
  <% else %>
    <div class="empty-state"><h2>No hay viajes disponibles por el momento.</h2></div>
  <% end %>
</section>
