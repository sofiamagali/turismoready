<section class="section container destination-form-page">
  <%= link_to "← Volver al viaje", trip_path(@trip), class: "text-link back-link" %>
  <div class="reservation-heading">
    <h1>Editar viaje</h1>
  </div>
  <p class="destination-description">Actualizá los datos de la salida, el alojamiento y el programa del viaje.</p>
  <%= render "form", trip: @trip, destinations: @destinations %>
</section>
