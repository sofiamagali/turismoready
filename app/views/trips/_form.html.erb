<%= form_with model: trip, class: "destination-form" do |form| %>
  <% if trip.errors.any? %>
    <div class="form-errors" role="alert">
      <h2>No se pudo guardar el viaje:</h2>
      <ul>
        <% trip.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <fieldset class="destination-field-wide trip-transport-field">
      <legend>¿Viajás en micro o en avión?</legend>
      <div class="trip-transport-options">
        <% Trip::TRANSPORT_TYPES.each do |value, label| %>
          <label class="trip-transport-option" for="trip_transport_type_<%= value %>">
            <%= form.radio_button :transport_type, value, required: true %>
            <span><%= label %></span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <div class="destination-field-wide">
      <%= form.label :destination_id, "Destino" %>
      <%= form.collection_select :destination_id, destinations, :id, :name, prompt: "Seleccioná un destino" %>
    </div>

    <div class="destination-field-wide">
      <%= form.label :name, "Nombre" %>
      <%= form.text_field :name %>
    </div>

    <div class="destination-field-wide">
      <%= form.label :description, "Descripción" %>
      <%= form.text_area :description, rows: 4 %>
    </div>

    <% { general_details: "Detalle general", excursions: "Excursiones", hotel_details: "Nuestra hotelería", itinerary: "Itinerario de actividades", boarding_points: "Aeropuertos o puntos de embarque" }.each do |field, label| %>
      <div class="destination-field-wide">
        <%= form.label field, label %>
        <%= form.text_area field, rows: 6 %>
      </div>
    <% end %>

    <div>
      <%= form.label :start_date, "Fecha de inicio" %>
      <%= form.date_field :start_date %>
    </div>

    <div>
      <%= form.label :end_date, "Fecha de fin" %>
      <%= form.date_field :end_date %>
    </div>

    <div>
      <%= form.label :flight, "Detalle del transporte" %>
      <%= form.text_field :flight %>
    </div>

    <div>
      <%= form.label :hotel, "Hotel" %>
      <%= form.text_field :hotel %>
    </div>

    <div>
      <%= form.label :board_type, "Pensión" %>
      <%= form.select :board_type, Trip.board_type_options %>
    </div>

    <div>
      <%= form.label :price, "Precio" %>
      <%= form.number_field :price, min: 0.01, step: 0.01 %>
    </div>

    <div>
      <%= form.label :available_slots, "Cupos disponibles" %>
      <%= form.number_field :available_slots, min: 0, step: 1 %>
    </div>
  </div>

  <div class="destination-active-field">
    <%= form.check_box :active %>
    <%= form.label :active, "Viaje activo" %>
  </div>

  <div class="destination-actions">
    <%= form.submit "Guardar viaje", class: "button" %>
    <%= link_to "Cancelar", trip.persisted? ? trip_path(trip) : trips_path, class: "text-link" %>
  </div>
<% end %>
