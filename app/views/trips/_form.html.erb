<%= form_with model: trip do |form| %>
  <% if trip.errors.any? %>
    <div>
      <h2>No se pudo guardar el viaje:</h2>
      <ul>
        <% trip.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :destination_id, "Destino" %><br>
    <%= form.collection_select :destination_id, destinations, :id, :name, prompt: "Seleccioná un destino" %>
  </div>

  <div>
    <%= form.label :name, "Nombre" %><br>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :description, "Descripción" %><br>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :start_date, "Fecha de inicio" %><br>
    <%= form.date_field :start_date %>
  </div>

  <div>
    <%= form.label :end_date, "Fecha de fin" %><br>
    <%= form.date_field :end_date %>
  </div>

  <div>
    <%= form.label :flight, "Vuelo" %><br>
    <%= form.text_field :flight %>
  </div>

  <div>
    <%= form.label :hotel, "Hotel" %><br>
    <%= form.text_field :hotel %>
  </div>

  <div>
    <%= form.label :board_type, "Pensión" %><br>
    <%= form.select :board_type, Trip.board_type_options %>
  </div>

  <div>
    <%= form.label :price, "Precio" %><br>
    <%= form.number_field :price, min: 0.01, step: 0.01 %>
  </div>

  <div>
    <%= form.label :available_slots, "Cupos disponibles" %><br>
    <%= form.number_field :available_slots, min: 0, step: 1 %>
  </div>

  <div>
    <%= form.check_box :active %>
    <%= form.label :active, "Activo" %>
  </div>

  <%= form.submit "Guardar viaje" %>
<% end %>
