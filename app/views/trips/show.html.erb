<section class="trip-detail">
  <div class="container">
    <%= link_to "← Volver a viajes", trips_path, class: "text-link back-link" %>
    <div class="trip-detail-grid">
      <div class="trip-detail-image">
        <% if @trip.destination.image_url.present? %>
          <%= image_tag @trip.destination.image_url, alt: @trip.destination.name %>
        <% else %>
          <div class="image-placeholder" role="img" aria-label="Imagen no disponible para <%= @trip.destination.name %>">
            <span><%= @trip.destination.city %></span>
          </div>
        <% end %>
      </div>

      <div class="trip-summary">
        <p class="eyebrow"><%= @trip.destination.city %>, <%= @trip.destination.country %></p>
        <h1><%= @trip.name %></h1>
        <p class="trip-description"><%= @trip.description.presence || "Una experiencia pensada para disfrutar este destino de principio a fin." %></p>
        <dl class="detail-facts">
          <div><dt>Fechas</dt><dd><%= @trip.start_date.strftime("%d/%m/%Y") %> — <%= @trip.end_date.strftime("%d/%m/%Y") %></dd></div>
          <div><dt>Vuelo</dt><dd><%= @trip.flight.presence || "A confirmar" %></dd></div>
          <div><dt>Hotel</dt><dd><%= @trip.hotel.presence || "A confirmar" %></dd></div>
          <div><dt>Pensión</dt><dd><%= @trip.board_type_label %></dd></div>
          <div><dt>Cupos disponibles</dt><dd><%= @trip.available_slots %></dd></div>
        </dl>
        <div class="booking-box">
          <div><span class="price-label">Precio por persona</span><strong class="detail-price"><%= number_to_currency(@trip.price, unit: "$", precision: 0, delimiter: ".") %></strong></div>
          <button class="button button-large" type="button" disabled title="Disponible en la próxima etapa">Reservar</button>
        </div>
        <p class="coming-soon">Las reservas estarán disponibles próximamente.</p>
      </div>
    </div>
  </div>
</section>
