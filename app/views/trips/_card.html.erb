<article class="trip-card">
  <div class="trip-card-image">
    <% if trip.destination.image_url.present? %>
      <%= image_tag trip.destination.image_url, alt: trip.destination.name, loading: "lazy" %>
    <% else %>
      <div class="image-placeholder" role="img" aria-label="Imagen no disponible para <%= trip.destination.name %>">
        <span><%= trip.destination.city %></span>
      </div>
    <% end %>
  </div>

  <div class="trip-card-content">
    <p class="trip-destination"><%= trip.destination.city %>, <%= trip.destination.country %></p>
    <h3><%= trip.name %></h3>
    <dl class="trip-facts">
      <div><dt>Fechas</dt><dd><%= trip.start_date.strftime("%d/%m/%Y") %> — <%= trip.end_date.strftime("%d/%m/%Y") %></dd></div>
      <div><dt>Vuelo</dt><dd><%= trip.flight.presence || "A confirmar" %></dd></div>
      <div><dt>Hotel</dt><dd><%= trip.hotel.presence || "A confirmar" %></dd></div>
      <div><dt>Pensión</dt><dd><%= trip.board_type_label %></dd></div>
    </dl>
    <div class="trip-card-footer">
      <div><span class="price-label">Precio por persona</span><strong class="price"><%= number_to_currency(trip.price, unit: "$", precision: 0, delimiter: ".") %></strong></div>
      <%= link_to "Ver viaje", trip_path(trip), class: "button" %>
    </div>
  </div>
</article>
