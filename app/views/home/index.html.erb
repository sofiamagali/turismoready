<section class="hero">
  <div class="container hero-content">
    <p class="eyebrow">Viajes que se sienten</p>
    <h1>Encontrá tu próximo destino.</h1>
    <p class="hero-copy">Elegí cómo querés viajar, descubrí los destinos y encontrá la fecha ideal para vos.</p>
    <%= link_to "Elegir cómo viajar", "#formas-de-viajar", class: "button button-large" %>
  </div>
</section>

<section class="section container" id="formas-de-viajar" aria-labelledby="transport-heading">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Tu viaje empieza acá</p>
      <h2 id="transport-heading">¿Cómo querés viajar?</h2>
    </div>
  </div>
  <div class="trip-grid">
    <%= link_to destinations_path(transport_type: "bus"), class: "transport-card" do %>
      <span class="transport-icon" aria-hidden="true">🚌</span>
      <h3>Viajes en micro</h3>
      <p>Disfrutá el camino y descubrí los destinos para viajar en micro.</p>
      <span class="text-link">Ver destinos en micro →</span>
    <% end %>
    <%= link_to destinations_path(transport_type: "airplane"), class: "transport-card" do %>
      <span class="transport-icon" aria-hidden="true">✈️</span>
      <h3>Viajes en avión</h3>
      <p>Encontrá los destinos para volar hacia tu próxima experiencia.</p>
      <span class="text-link">Ver destinos en avión →</span>
    <% end %>
  </div>
</section>
