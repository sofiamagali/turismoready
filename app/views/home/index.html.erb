<section class="hero">
  <div class="container hero-content">
    <p class="eyebrow">Viajes que se sienten</p>
    <h1>Encontrá tu próximo destino.</h1>
    <p class="hero-copy">Paquetes pensados para que disfrutes desde el primer momento: vuelo, hotel y experiencias en un solo lugar.</p>
    <%= link_to "Explorar viajes", trips_path, class: "button button-large" %>
  </div>
</section>

<section class="section container">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Elegidos para vos</p>
      <h2>Viajes destacados</h2>
    </div>
    <%= link_to "Ver todos", trips_path, class: "text-link" %>
  </div>

  <% if @featured_trips.any? %>
    <div class="trip-grid">
      <%= render partial: "trips/card", collection: @featured_trips, as: :trip %>
    </div>
  <% else %>
    <div class="empty-state">
      <h3>Próximamente nuevos viajes</h3>
      <p>Estamos preparando experiencias para vos.</p>
    </div>
  <% end %>
</section>
