<section class="login-page container" aria-labelledby="login-title">
<div class="login-card">
  <header class="login-heading">
    <p class="eyebrow">Bienvenida a AeroDevs</p>
    <h1 id="login-title">Iniciar sesión</h1>
    <p>Ingresá a tu cuenta para seguir planeando tu próximo viaje.</p>
  </header>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "login-form" }) do |f| %>
  <div class="login-field">
    <%= f.label :email, "Correo electrónico" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true %>
  </div>

  <div class="login-field">
    <%= f.label :password, "Contraseña" %>
    <%= f.password_field :password, autocomplete: "current-password", required: true %>
  </div>

  <div class="login-options">
    <% if devise_mapping.rememberable? %>
      <label class="login-remember" for="user_remember_me">
        <%= f.check_box :remember_me, id: "user_remember_me" %>
        <span>Recordarme</span>
      </label>
    <% end %>
    <% if devise_mapping.recoverable? %>
      <%= link_to "¿Olvidaste tu contraseña?", new_password_path(resource_name), class: "text-link" %>
    <% end %>
  </div>

  <div class="actions">
    <%= f.submit "Iniciar sesión", class: "button login-submit" %>
  </div>
<% end %>

<% if devise_mapping.registerable? %>
  <p class="login-signup">¿Todavía no tenés cuenta? <%= link_to "Registrate", new_registration_path(resource_name), class: "text-link" %></p>
<% end %>
</div>
</section>
